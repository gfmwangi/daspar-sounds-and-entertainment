{
  "name": "daspar-sounds-and-entertainment",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "dev:backend": "node --watch server/server.js",
    "dev:frontend": "node scripts/render-catalogue.mjs && vite --config vite.config.js --host 0.0.0.0 --port 3000",
    "dev:static": "node scripts/render-catalogue.mjs && vite --config vite.config.js --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "build": "node scripts/render-catalogue.mjs && vite --config vite.config.js build",
    "build:static": "node scripts/render-catalogue.mjs && vite --config vite.config.js build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:static": "vite --config vite.config.js preview --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "db:migrate": "node server/scripts/migrate.js",
    "admin:create": "node server/scripts/create-admin.js",
    "admin:reset": "node server/scripts/reset-admin.js",
    "db:backup": "node server/scripts/backup-db.js",
    "db:restore": "node server/scripts/restore-db.js",
    "test:backend": "node --test"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  },
  "packageManager": "pnpm@10.18.0"
}
