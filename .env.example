# DASPAR Sounds & Entertainment - Backend Environment Configuration

# Server Port
PORT=5000

# Environment: development or production
NODE_ENV=development

# Session Encryption / Signing Secret
SESSION_SECRET=daspar_sounds_super_secret_session_key_2026

# Administrator Bootstrap Credentials (used on initial seed if no admin exists)
ADMIN_EMAIL=admin@daspar.co.ke
ADMIN_INITIAL_PASSWORD=DasparAdmin2026!

# Allowed Frontend Origins for Cross-Origin Development (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Product Image Upload Directory (relative to project root)
PRODUCT_ASSETS_DIR=client/public/assets/products

# Contact Inquiry Recipient Email (business inquiries destination)
CONTACT_RECIPIENT_EMAIL=dasparent@outlook.com

# Optional database URL seam (e.g., PostgreSQL for future production cloud deployment)
# DATABASE_URL=postgresql://user:password@localhost:5432/daspar_db
