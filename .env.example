# Copy to .env for local work. Keep .env private and never commit it.
NODE_ENV=development
PORT=5000
SERVER_HOST=127.0.0.1
TRUST_PROXY_HOPS=0

# Required: use a private PostgreSQL database; never paste production data into local tests.
DATABASE_URL=
DATABASE_SSL=false

# Required: generate a fresh random value of at least 32 bytes for this environment.
SESSION_SECRET=

# Exact website origins only. Add the deployed website origin after choosing a host/domain.
PUBLIC_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Optional integrations; upload and emailed recovery remain unavailable until configured.
CLOUDINARY_URL=
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_RECIPIENT_EMAIL=dasparent@outlook.com

# Only for the one-time private bootstrap CLI; never set these in browser-facing build variables.
ADMIN_SETUP_EMAIL=
ADMIN_SETUP_PASSWORD=
ADMIN_RESET_EMAIL=
ADMIN_RESET_PASSWORD=

# Optional encrypted pg_dump backups; generate a new private 32-byte key per environment.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
